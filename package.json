{
  "name": "collectto",
  "version": "1.0.0",
  "scripts": {
    "android": "expo start --android",
    "ios": "expo start --ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" --max-warnings=0",
    "lint:fix": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\"",
    "format:check": "prettier -c \"**/*.{js,jsx,ts,tsx,json,css,md,yaml,yml}\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "cache:clear": "expo start --clear",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.4",
    "axios": "^1.15.2",
    "expo": "^55.0.19",
    "expo-blur": "~55.0.14",
    "expo-checkbox": "~55.0.4",
    "expo-constants": "^55.0.15",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "^55.0.14",
    "expo-router": "^55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "^55.0.19",
    "expo-status-bar": "~55.0.5",
    "nativewind": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "^0.83.6",
    "react-native-calendars": "^1.1314.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-reanimated": "^4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "^15.15.3",
    "react-native-worklets": "^0.7.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~55.0.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "main": "expo-router/entry",
  "private": true
}
